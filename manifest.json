{
  "manifest_version": 3,
  "name": "Studocx",
  "version": "1.0",
  "description": "Extension hỗ trợ tự động tạo và nạp tài liệu kích hoạt nhanh Studocu Premium",
  "author": "tiendat513",

  "permissions": ["storage"],
  "action": {
    "default_title": "Studocx",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.studocu.vn/vn/document/upload*"],
      "js": ["shared/docx-generator.js", "content/form-filler.js", "content/uploader.js"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
